[flake8]

# Black formats this code, and these checks disagree with its output:
# E203 (whitespace before ':'): Black spaces the ':' of complex slices.
# E501 (line too long): Black wraps code, but not long strings or comments.
# W503 (line break before a binary operator): Black breaks before them. It is
# disabled by default, but must be listed explicitly when using `ignore`.
ignore = E203, E501, W503
per-file-ignores =
    files_sdk/__init__.py: F401,F811
    files_sdk/models/__init__.py: F401,F811
